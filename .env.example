# Shared environment configuration for every architecture in this repo.
# Copy to .env to apply. .env is gitignored.
#
# arch-A and arch-D load this file directly. arch-B, arch-C, and arch-E
# do not call any external API so they read nothing from here today.

# --- Ollama (required for any ai-* / agent demo) ---------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# --- Tavily (optional; enables live publisher fetches) ----------------
# When set, the Tavily caller fetches a real snippet instead of returning
# the canned fragment. Free tier at https://tavily.com gives ~1000
# searches/month.
# TAVILY_API_KEY=tvly-...
# TAVILY_TIMEOUT_MS=5000

# --- Fixture-gate (optional; replaces the live calls with checked-in JSON) ---
# Set to "1" to use a default fixture, or to a variant name to pick one
# explicitly. See core/fixtures/ for the variants that ship today.
# TAVILY_FIXTURE=1
# OLLAMA_FIXTURE=tool_call

# --- arch-D HTTP entry (optional; only consumed by `npm run start` in arch-D) ---
ASSISTANT_PORT=4011
