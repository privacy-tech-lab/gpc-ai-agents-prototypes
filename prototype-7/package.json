{
  "name": "prototype-7",
  "version": "1.0.0",
  "description": "Persistence: opting out of how long data survives. Session, cross-session, and long-term profile scopes, hierarchical.",
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "baseline": "node run_baseline.js",
    "optout:full": "node run_optout.js --gpc",
    "optout:session": "node run_optout.js --scope=session",
    "optout:cross_session": "node run_optout.js --scope=cross_session",
    "optout:profile": "node run_optout.js --scope=profile",
    "demo": "node run_baseline.js && node run_optout.js --scope=session && node run_optout.js --scope=cross_session && node run_optout.js --scope=profile",
    "agent": "node run_agent.js",
    "agent:session": "node run_agent.js --scope=session",
    "agent:cross_session": "node run_agent.js --scope=cross_session",
    "test": "jest tests/ --runInBand"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  }
}
