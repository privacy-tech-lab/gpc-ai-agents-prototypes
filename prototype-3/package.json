{
  "name": "prototype-3",
  "version": "1.0.0",
  "description": "Consent-Scoped Tool Registry — GPC capability expansion control",
  "type": "commonjs",
  "license": "ISC",
  "scripts": {
    "v1": "node run_v1.js",
    "v2:silent": "node run_v2.js --mode=silent",
    "v2:approve": "node run_v2.js --mode=approve",
    "v2:decline": "node run_v2.js --mode=decline",
    "v2:gpc": "node run_v2.js --mode=approve --gpc",
    "demo": "node run_v1.js && node run_v2.js --mode=silent && node run_v2.js --mode=approve && node run_v2.js --mode=decline && node run_v2.js --mode=approve --gpc",
    "agent": "node run_agent.js --mode=approve",
    "agent:decline": "node run_agent.js --mode=decline",
    "agent:gpc": "node run_agent.js --mode=approve --gpc",
    "test": "jest tests/ --runInBand"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
