{
  "name": "prototype-8",
  "version": "1.0.0",
  "description": "Delegation gate: privacy preferences for which choices the agent may resolve on your behalf, with user-asserted action tiers.",
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "baseline": "node run_baseline.js",
    "optout": "node run_optout.js",
    "optout:decline": "node run_optout.js --respond=decline",
    "optout:unattended": "node run_optout.js --unattended",
    "optout:gpc": "node run_optout.js --gpc",
    "optout:strict": "node run_optout.js --gpc --unattended",
    "demo": "node run_baseline.js && node run_optout.js && node run_optout.js --unattended && node run_optout.js --gpc",
    "agent": "node run_agent.js",
    "agent:unattended": "node run_agent.js --unattended",
    "agent:gpc": "node run_agent.js --gpc",
    "test": "jest tests/ --runInBand"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  }
}
