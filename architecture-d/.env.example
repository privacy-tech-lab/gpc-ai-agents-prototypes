# Architecture D environment configuration.
# Copy to .env to apply. .env is gitignored.

# --- Ollama (required for ai-* run modes) ----------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- Tavily (optional; enables live publisher fetches) ----------------
# When set, site_handlers.js fetches a real snippet from each publisher's
# domain via Tavily instead of returning the canned fragment. Free tier
# at https://tavily.com gives ~1000 searches/month.
# TAVILY_API_KEY=tvly-...
